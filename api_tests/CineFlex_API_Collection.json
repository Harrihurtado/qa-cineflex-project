{
  "info": {
    "_postman_id": "185f903f-2946-4d95-b91f-f18a9df768ec",
    "name": "CineFlex API",
    "description": "Suite automatizada de API para CineFlex (Fase B)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type es JSON\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"La respuesta trae un JWT válido (3 partes)\", () => {",
              "  pm.expect(json).to.have.property(\"token\");",
              "  pm.expect(json.token.split(\".\")).to.have.lengthOf(3);",
              "});",
              "pm.test(\"Helmet activo (X-Content-Type-Options: nosniff)\", () => {",
              "  pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\");",
              "});",
              "// Captura dinámica del token JWT en el environment",
              "pm.environment.set(\"token\", json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@cineflex.com\",\n  \"password\": \"Cine123*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Cartelera (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "let json;",
              "pm.test(\"La respuesta es un JSON válido\", () => {",
              "  json = pm.response.json();",
              "  pm.expect(json).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"SLA: tiempo de respuesta < 300ms\", () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(300);",
              "});",
              "pm.test(\"Cada película tiene id, titulo y genero\", () => {",
              "  json.forEach(p => pm.expect(p).to.include.all.keys(\"id\", \"titulo\", \"genero\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cartelera",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cartelera"
          ]
        }
      }
    },
    {
      "name": "3. Reserva con tarjeta falsa (POST - negativa)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"El backend rechaza la transacción (400 o 402)\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([400, 402]);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Mensaje de error correcto\", () => {",
              "  pm.expect(json.error).to.eql(\"Pago rechazado: tarjeta inválida\");",
              "});",
              "pm.test(\"No se generó ticket\", () => {",
              "  pm.expect(json).to.not.have.property(\"ticket\");",
              "});",
              "pm.test(\"Content-Type es JSON\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"peliculaId\": 3,\n  \"asiento\": \"E6\",\n  \"tarjeta\": {\n    \"titular\": \"QA Tester\",\n    \"numero\": \"1234567890123456\",\n    \"vencimiento\": \"12/30\",\n    \"cvv\": \"123\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        }
      }
    }
  ]
}